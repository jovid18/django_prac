# このファイルをコピーして .env を作る:
#   cp .env.example .env
# .env は .gitignore に入っているので commit されない。

# --- Google OAuth ---------------------------------------------------------
# ブラウザのバンドルに埋まる公開値なので、秘密ではない。
# クライアントシークレットは今回の構成では一切使わない（docs/06-auth.md）。
GOOGLE_OAUTH_CLIENT_ID=

# --- 以下はローカルでは docker-compose.yml に直書きしてあるので不要 -------
# DJANGO_SECRET_KEY=      # 開発用の値を compose に記載済み（32 文字以上必須）
# DATABASE_URL=           # compose が db サービスを指すよう設定済み
# VITE_API_BASE_URL=      # ローカルは空（Vite の proxy を使う）
