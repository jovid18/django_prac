# このファイルをコピーして .env を作る:
#   cp .env.example .env
# .env は .gitignore に入っているので commit されない。

# --- Google OAuth ---------------------------------------------------------
# ブラウザのバンドルに埋まる公開値なので、秘密ではない。
# クライアントシークレットは今回の構成では一切使わない（docs/06-auth.md）。
GOOGLE_OAUTH_CLIENT_ID=

# --- Google Maps ----------------------------------------------------------
# Maps JavaScript API のキー。OAuth クライアント ID と同じ Cloud プロジェクトで作れる。
#
# ⚠ これは「公開されるが課金に直結する」値。バンドルに埋まって誰でも読めるので、
#   Cloud Console で必ず制限を掛ける:
#     - アプリケーションの制限: HTTP リファラー（localhost:5173 と本番 URL）
#     - API の制限: Maps JavaScript API のみ
#   制限が無いキーを晒すと、他人の利用が自分の請求先に乗る。
GOOGLE_MAPS_API_KEY=

# Map ID。Advanced Markers に必須。空なら DEMO_MAP_ID が使われる（ローカルはそれで十分）。
# 独自のスタイル（配色・POI の出し方）を当てたいときだけ Cloud Console で作る。
GOOGLE_MAPS_MAP_ID=

# --- 以下はローカルでは docker-compose.yml に直書きしてあるので不要 -------
# DJANGO_SECRET_KEY=      # 開発用の値を compose に記載済み（32 文字以上必須）
# DATABASE_URL=           # compose が db サービスを指すよう設定済み
# VITE_API_BASE_URL=      # ローカルは空（Vite の proxy を使う）
